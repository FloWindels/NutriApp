APP_NAME="Mavi'oh"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC
APP_LOCALE=fr

# URL du client web (liens de réinitialisation de mot de passe)
FRONTEND_URL=http://localhost:3000

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données ---------------------------------------------------------
# Dev / tests : SQLite (fichier database/database.sqlite, à créer vide).
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Production : PostgreSQL (MySQL non pris en charge).
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=mavioh
# DB_USERNAME=mavioh
# DB_PASSWORD=

# --- Authentification (Sanctum) ---------------------------------------------
# Durée de vie des jetons en minutes (43200 = 30 jours). Purge quotidienne planifiée.
SANCTUM_EXPIRATION=43200

# --- Open Food Facts --------------------------------------------------------
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT="Mavioh/1.0 (contact@mavioh.app)"

# --- Coach sportif IA (Anthropic, optionnel) --------------------------------
# Laisser ANTHROPIC_API_KEY vide pour désactiver l'IA : les séances sont alors
# proposées par les règles Mavi'oh.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_TIMEOUT=90

# --- Cache / files / sessions -----------------------------------------------
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail (log en local : les e-mails de réinitialisation vont dans storage/logs) ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="bonjour@mavioh.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
