# Mavi'oh — configuration des conteneurs. Copier en docker/.env (jamais versionné) et remplir.

# --- Adresses publiques (routes du tunnel Cloudflare) ------------------------
# Un seul niveau de sous-domaine : le certificat gratuit de Cloudflare couvre *.domaine,
# pas *.*.domaine — d'où mavioh-api.domaine et non api.mavioh.domaine.
APP_URL=https://mavioh-api.exemple.com
FRONTEND_URL=https://mavioh.exemple.com

# Ports locaux vers lesquels pointent les routes du tunnel (127.0.0.1 uniquement).
WEB_PORT=3100
API_PORT=8100

# --- Secrets -----------------------------------------------------------------
# APP_KEY : docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_KEY=
# DB_PASSWORD : openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=

APP_NAME="Mavi'oh"
APP_TIMEZONE=UTC
APP_LOCALE=fr
SANCTUM_EXPIRATION=20160

OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT="Mavioh/1.0 (florentwindels@gmail.com)"

# --- IA locale (Ollama sur le GPU) --------------------------------------------
# Un seul modèle multimodal pour le coach, les recettes, le planificateur et la photo
# d'assiette : il reste chargé et n'est jamais échangé contre un autre.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.3
# Délais courts : Cloudflare coupe toute réponse au-delà de 100 s (erreur 524).
# Attente dans la file (OLLAMA_QUEUE_WAIT) + génération doivent rester en dessous.
OLLAMA_TIMEOUT=70
OLLAMA_VISION_TIMEOUT=70

# File d'attente partagée par tous les comptes :
#   OLLAMA_SLOTS       générations simultanées sur le GPU
#   OLLAMA_QUEUE       demandes qui peuvent attendre leur tour au-delà
#   OLLAMA_QUEUE_WAIT  attente maximale (s) avant « l'IA est très demandée, réessaie »
OLLAMA_SLOTS=2
OLLAMA_QUEUE=6
OLLAMA_QUEUE_WAIT=20

# --- Courriels (réinitialisation de mot de passe) -----------------------------
# "log" n'envoie rien. Pour de vrais envois, renseigner un serveur SMTP.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bonjour@exemple.com"
MAIL_FROM_NAME="Mavi'oh"

# Clé interne du moteur de recherche SearXNG : openssl rand -base64 32 | tr -d "/+="
SEARXNG_SECRET=
