# Mavi'oh — configuration Nginx sans nom de domaine.
#
# À utiliser tant qu'aucun domaine ne pointe vers le serveur. Tout passe en HTTP, sans
# certificat : réserve ce mode au réseau local et aux essais.
#
#   port 80   : le site Next.js, y compris ses routes /api/** qui relaient vers Laravel
#   port 8080 : l'API Laravel elle-même, pour l'application mobile
#               (install.sh en choisit un autre si celui-ci est déjà pris)
#
# Le découpage est imposé par l'architecture du site : le navigateur n'appelle jamais Laravel
# directement, il appelle les gestionnaires de routes Next sous /api/**, qui transmettent côté
# serveur. Router /api vers Laravel au niveau de Nginx couperait le site de son propre relais.
#
#   sudo cp scripts/deploy/nginx-ip.conf.example /etc/nginx/sites-available/mavioh
#   sudo ln -sf /etc/nginx/sites-available/mavioh /etc/nginx/sites-enabled/mavioh
#   sudo rm -f /etc/nginx/sites-enabled/default
#   sudo nginx -t && sudo systemctl reload nginx
#
# Puis, dans backend/.env :  APP_URL=http://<ip>:8080      FRONTEND_URL=http://<ip>
# dans web/.env.local :      API_URL=http://127.0.0.1:8080/api
# et pour l'APK :            --dart-define=API_BASE_URL=http://<ip>:8080/api

# --- Site Next.js (et ses routes /api/**) -----------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    client_max_body_size 12M;          # photos de recettes en base64

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;        # les appels IA transitent par les route handlers Next
        proxy_cache_bypass $http_upgrade;
    }

    access_log /var/log/nginx/mavioh-web.access.log;
    error_log  /var/log/nginx/mavioh-web.error.log;
}

# --- API Laravel ------------------------------------------------------------
server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /var/www/mavioh/backend/public;
    index index.php;

    charset utf-8;
    client_max_body_size 12M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_read_timeout 120s;      # la génération IA d'une séance peut durer ~60 s
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    access_log /var/log/nginx/mavioh-api.access.log;
    error_log  /var/log/nginx/mavioh-api.error.log;
}
