# Mavi'oh — configuration Nginx.
# Copier dans /etc/nginx/sites-available/mavioh puis remplacer les deux domaines.
# Certbot ajoutera ensuite les blocs TLS et la redirection HTTP -> HTTPS.

# --- API Laravel ------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name api.mavioh.mondomaine.fr;

    root /var/www/mavioh/backend/public;
    index index.php;

    charset utf-8;
    client_max_body_size 12M;          # photos de recettes en base64

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_read_timeout 120s;      # la génération IA d'une séance peut durer ~60 s
        include fastcgi_params;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }

    access_log /var/log/nginx/mavioh-api.access.log;
    error_log  /var/log/nginx/mavioh-api.error.log;
}

# --- Site web Next.js -------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name mavioh.mondomaine.fr;

    client_max_body_size 12M;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 130s;        # les appels IA transitent par les route handlers Next
        proxy_cache_bypass $http_upgrade;
    }

    access_log /var/log/nginx/mavioh-web.access.log;
    error_log  /var/log/nginx/mavioh-web.error.log;
}

# --- Variante : un seul domaine --------------------------------------------
# Le navigateur n'appelle jamais Laravel directement : il appelle les gestionnaires de
# routes Next sous /api/**, qui relaient côté serveur. Router /api vers Laravel dans le
# bloc du site couperait donc le site de son propre relais.
#
# Avec un seul domaine, sers plutôt Laravel sur un port distinct : reprends le bloc « API »
# ci-dessus en remplaçant « listen 80 » par « listen 8443 ssl », garde le même certificat,
# et pointe API_URL sur http://127.0.0.1:8080/api (appel interne, jamais exposé).
# L'application mobile, elle, vise https://mavioh.mondomaine.fr:8443/api.
