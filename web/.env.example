# Copie ce fichier en `.env.local` puis adapte les valeurs.

# URL de l’API Laravel utilisée par les route handlers Next (côté serveur).
# Par défaut : http://127.0.0.1:8000/api
API_URL=http://127.0.0.1:8000/api

# Même URL exposée au navigateur (fallback si API_URL n’est pas défini).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Origines supplémentaires autorisées sur le serveur de développement (liste séparée par des virgules),
# par exemple l’IP de ton PC pour tester depuis un téléphone : 192.168.1.20,*.local
NEXT_ALLOWED_DEV_ORIGINS=
